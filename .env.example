# ==============================================================================
# NIBRAS HOUSE - ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env.local lalu isi dengan kredensial asli Anda.
# ==============================================================================

# --- Firebase Client Configuration ---
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# --- Master Role Default Credentials (Fallback Auth) ---
NEXT_PUBLIC_AUTH_OWNER_EMAIL="owner@example.com"
NEXT_PUBLIC_AUTH_OWNER_PASS="change-me-strong-password"
NEXT_PUBLIC_AUTH_ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_AUTH_ADMIN_PASS="change-me-strong-password"
NEXT_PUBLIC_AUTH_KASIR_A_EMAIL="kasir-a@example.com"
NEXT_PUBLIC_AUTH_KASIR_A_PASS="change-me-strong-password"
NEXT_PUBLIC_AUTH_KASIR_B_EMAIL="kasir-b@example.com"
NEXT_PUBLIC_AUTH_KASIR_B_PASS="change-me-strong-password"
NEXT_PUBLIC_AUTH_KASIR_C_EMAIL="kasir-c@example.com"
NEXT_PUBLIC_AUTH_KASIR_C_PASS="change-me-strong-password"

# --- Portal Absensi Karyawan ---
NEXT_PUBLIC_ABSENSI_EMAIL_DOMAIN="absensi.example.com"
NEXT_PUBLIC_ABSENSI_SESSION_KEY="change-me-session-key"

# --- Cloudinary (Opsional untuk Foto Selfie Absensi) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_FOLDER="absensi-selfie"

# --- Google GenAI / Genkit (Server-side only) ---
GOOGLE_GENAI_API_KEY=""
